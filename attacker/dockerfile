# attacker/Dockerfile - immagine basata su golang:1.23 con git, python3 e node/npm
FROM golang:1.23

# installo git, python3, pip, node e npm; poi pulisco cache apt
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
    git \
    python3 \
    python3-pip \
    nodejs \
    npm \
 && rm -rf /var/lib/apt/lists/*

# crea la cartella di lavoro
WORKDIR /app

# copio lo script attacker (utile anche se monti il volume)
COPY attacker.sh /app/attacker.sh
RUN chmod +x /app/attacker.sh

# default: rimani in sleep per consentire accesso interattivo
CMD ["bash", "-lc", "sleep infinity"]
