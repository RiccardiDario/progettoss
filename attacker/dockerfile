FROM golang:1.23

# installo git, python3, pip, node e npm e certificati; poi pulisco cache apt
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
    ca-certificates \
    git \
    nghttp2-client \
    python3 \
    python3-pip \
    nodejs \
    npm \
 && rm -rf /var/lib/apt/lists/*


WORKDIR /app
RUN set -e; \
    POC_DIR="/app/poc"; \
    rm -rf "$POC_DIR"; \
    git clone --depth 1 https://github.com/lirantal/CVE-2024-27983-nodejs-http2.git "$POC_DIR"; \
    cd "$POC_DIR"; \
    git rev-parse --abbrev-ref HEAD 2>/dev/null || true; \
    git log -n 1 --pretty=format:"%h %s" 2>/dev/null || true; \
    if [ -f "go.mod" ]; then \
      go mod download; \
    fi; \
    if [ -f "requirements.txt" ]; then \
      pip3 install --no-cache-dir --user -r requirements.txt || true; \
    fi

CMD ["bash", "-lc", "sleep infinity"]